# MQTT Broker Configuration
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC=flutter/sensors/2
MQTT_USERNAME=tu_usuario
MQTT_PASSWORD=tu_contraseña

# MQTT Reconnection Settings
MQTT_FIRST_RECONNECT_DELAY=1
MQTT_RECONNECT_RATE=2
MQTT_MAX_RECONNECT_COUNT=12
MQTT_MAX_RECONNECT_DELAY=60

# Parámetros del servicio FastAPI para ingesta en tiempo real (ejemplo)
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=9000
FASTAPI_RELOAD=true
FASTAPI_APP_TITLE="Demo Industrial Gateway"
FASTAPI_APP_VERSION=0.1.0
FASTAPI_LOG_LEVEL=DEBUG
FASTAPI_SENSOR_LOG_PATH=./outputs/demo_sensor_stream.jsonl
